<UserControl x:Class="IPsecSecurityAnalyzer.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:IPsecSecurityAnalyzer.Utilities.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisConv" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Stretch">

            <!-- Title Section -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Security Reports &amp; Export" Style="{StaticResource TitleHeaderStyle}" />
                    <TextBlock Text="Generate auditor-grade PDF compliance reports and structured JSON snapshots." Style="{StaticResource SubtitleHeaderStyle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding GenerateReportCommand}" Height="36" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconReports}" Fill="#090D16" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Generate PDF Report" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ExportJsonCommand}" Height="36">
                        <TextBlock Text="Export JSON" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Status Banner Card -->
            <Border Style="{StaticResource SocCardBorderStyle}" Padding="24" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4" />
                        <TextBlock Text="Reports incorporate observed IPsec handshake parameters, cryptographic security findings, recommendations, and explainable AI traffic classifications." 
                                   FontSize="12.5" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" LineHeight="18" />
                    </StackPanel>
                    <Path Grid.Column="1" Data="{StaticResource IconReports}" Fill="{StaticResource BrushAccentCyan}" Width="36" Height="36" Stretch="Uniform" VerticalAlignment="Center" Margin="20,0,0,0" Opacity="0.8" />
                </Grid>
            </Border>

            <!-- Report Contents Outline Overview -->
            <Border Style="{StaticResource SocCardBorderStyle}" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Standard Report Sections" Style="{StaticResource CardHeaderStyle}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="• Section 1: Executive Summary &amp; Risk Metrics" Foreground="{StaticResource BrushTextPrimary}" FontSize="12.5" Margin="0,3" />
                            <TextBlock Text="• Section 2: Analysis Scope &amp; Methodology" Foreground="{StaticResource BrushTextPrimary}" FontSize="12.5" Margin="0,3" />
                            <TextBlock Text="• Section 3: Traffic Volume &amp; Protocol Footprint" Foreground="{StaticResource BrushTextPrimary}" FontSize="12.5" Margin="0,3" />
                            <TextBlock Text="• Section 4: IPsec &amp; IKE Protocol Dissection" Foreground="{StaticResource BrushTextPrimary}" FontSize="12.5" Margin="0,3" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="• Section 5: Cryptographic Vulnerability Findings" Foreground="{StaticResource BrushTextPrimary}" FontSize="12.5" Margin="0,3" />
                            <TextBlock Text="• Section 6: Prioritized Remediation Actions" Foreground="{StaticResource BrushTextPrimary}" FontSize="12.5" Margin="0,3" />
                            <TextBlock Text="• Section 7: AI Traffic Classification &amp; Anomalies" Foreground="{StaticResource BrushTextPrimary}" FontSize="12.5" Margin="0,3" />
                            <TextBlock Text="• Section 8: Assessment Limitations &amp; Ethical Notice" Foreground="{StaticResource BrushTextPrimary}" FontSize="12.5" Margin="0,3" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Report History Section -->
            <Border Style="{StaticResource SocCardBorderStyle}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Recently Generated Reports in this Session" Style="{StaticResource CardHeaderStyle}" Margin="0,0,0,12" />
                    <TextBlock Text="No reports generated in current session. Click 'Generate PDF Report' above to export." 
                               Visibility="{Binding HasReports, Converter={StaticResource BoolToVisConv}, ConverterParameter=invert}"
                               Foreground="{StaticResource BrushTextMuted}" FontSize="12.5" />
                    <ItemsControl ItemsSource="{Binding GeneratedReports}" Visibility="{Binding HasReports, Converter={StaticResource BoolToVisConv}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0A0E1A" CornerRadius="6" Padding="12,8" Margin="0,3">
                                    <Grid>
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource BrushAccentCyan}" FontSize="12" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
